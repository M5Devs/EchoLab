# Firebase Configuration (OPTIONAL)
# EchoLab is offline-first: it runs as a complete local studio with no .env at
# all. Cloud sync (accounts, cloud projects, shared presets) is the only feature
# these values enable. If they are absent or left as placeholders the app detects
# it, hides the sign-in UI, and shows "Local only" instead of crashing.
# Copy this file to .env and fill in real values to enable cloud sync.
# NEVER commit .env — it is listed in .gitignore.
# Find these values in: Firebase Console → Project Settings → Your apps → SDK setup

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id

# CORS Audio Proxy (optional)
# Remote streaming URLs (SoundCloud, external CDNs) are relayed through a
# Cloudflare Worker because those hosts omit CORS headers. Deploy the worker in
# cloudflare-worker/ and point this at it:
#   cd cloudflare-worker && npx wrangler deploy
# When unset, the app uses the same-origin /api/audio-proxy route, which is
# served in development by tools/devAudioProxy.ts.
VITE_AUDIO_PROXY_URL=
